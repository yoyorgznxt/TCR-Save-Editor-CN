<Window x:Class="TCRSaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCRSaveEditor"
        mc:Ignorable="d"
        Title="全面冲突：抵抗 - 存档编辑器" Height="450" Width="800" Background="LightGray">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_操作">
                <MenuItem x:Name="action_opensave" Header="_打开存档" Click="action_opensave_Click"/>
                <MenuItem x:Name="action_savechanges" Header="_保存修改" Click="action_savechanges_Click"/>
                <MenuItem x:Name="action_install" Header="_安装到游戏" Click="action_install_Click"/>
            </MenuItem>
            <MenuItem Header="_帮助">
                <MenuItem Header="_查看帮助" Click="ViewHelp_Click"/>
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <TextBlock Text="玩家状态" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"></TextBlock>
            <TextBlock Text="政治点数:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding GameMeta.PoliticPoints, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,15,0"/>
            <TextBlock Text="权威点数:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding GameMeta.AuthorityPoints, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,15,0"/>
            <TextBlock Text="稳定点数:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding GameMeta.StabilityPoints, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,15,0"/>
            <TextBlock Text="独裁度:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding GameMeta.DictatorShip, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <TextBlock Text="派系:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="FactionFilterCombo"
                  ItemsSource="{Binding Factions}"
                  SelectionChanged="FactionFilterCombo_SelectionChanged"
                  Width="150"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CitiesGrid"
                  Grid.Column="0"
                  ItemsSource="{Binding FilteredCities}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="5,5,74,5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="地图名称" Binding="{Binding MapName}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="派系" Binding="{Binding Faction}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="人口" Binding="{Binding PeoplesCount, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="资源" FontWeight="Bold" Margin="0,0,0,5"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedItem.Resources, ElementName=CitiesGrid}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Name}" Width="150" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>